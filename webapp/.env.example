# === Веб-сервер ===
PORT=8080
# Публичный адрес панели (используется в ссылках в email-уведомлениях)
BASE_URL=https://mp4.example.com

# === Авторизация в панели ===
ADMIN_USERNAME=admin
# Либо простой пароль (проще, но менее безопасно)...
ADMIN_PASSWORD=change-me
# ...либо bcrypt-хэш пароля (рекомендуется для прода). Сгенерировать:
#   node -e "console.log(require('bcryptjs').hashSync('mypassword', 10))"
# ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-string

# === Хранение данных ===
# По умолчанию всё внутри ./data (база SQLite, логи, готовые mp4)
DATA_DIR=./data
LOG_DIR=./data/logs
OUTPUT_DIR=./data/output
DB_PATH=./data/bbb-mp4.db

# === Движок конвертации ===
# docker (по умолчанию, использует образ bbb-mp4-worker, собранный из корневого Dockerfile)
# local  (запускает `node bbb-mp4.js <url>` напрямую на этом сервере, без Docker;
#         требует установленных Chrome/ffmpeg/Xvfb/Pulseaudio и `npm install` в корне репозитория)
WORKER_MODE=docker
CONVERTER_IMAGE=bbb-mp4-worker
# Опционально — ограничение ресурсов на контейнер в режиме docker
# DOCKER_CPUS=2
# DOCKER_MEMORY=2g
# Путь к корню репозитория (для WORKER_MODE=local). По умолчанию — на уровень выше webapp/.
# REPO_ROOT=..

MAX_CONCURRENT_JOBS=2

# Ограничить, с каких хостов разрешено принимать ссылки на запись (через запятую).
# Пусто = разрешены любые хосты (не рекомендуется в публичном интернете).
# ALLOWED_HOSTS=vks.vsesem.ru

# === Email-уведомления (внешний SMTP) ===
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me
SMTP_FROM="BBB MP4 <no-reply@example.com>"
NOTIFY_EMAIL_DEFAULT=
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_FAILURE=true
